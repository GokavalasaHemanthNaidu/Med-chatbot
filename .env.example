# Environment Variables Configuration File

# Flask Configuration
FLASK_ENV=development
FLASK_APP=wsgi.py
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://medbot_user:password@localhost:5432/medbot
POSTGRES_USER=medbot_user
POSTGRES_PASSWORD=password
POSTGRES_DB=medbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_DEBUG=False

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_ENV=development

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Model Configuration
MODEL_PATH=ml/models/chatbotmodel.h5
WORDS_PKL_PATH=ml/models/words.pkl
CLASSES_PKL_PATH=ml/models/classes.pkl
INTENTS_JSON_PATH=ml/data/intents.json
CONFIDENCE_THRESHOLD=0.75

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/medbot.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=medbot@yourdomain.com
NOTIFICATION_EMAIL=admin@yourdomain.com

# Monitoring Configuration
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin

# Airflow Configuration
AIRFLOW_HOME=/opt/airflow
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags

# Cloud Storage (AWS S3 - Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=medbot-bucket
AWS_REGION=us-east-1

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# Analytics Configuration
ANALYTICS_ENABLED=True
ANALYTICS_RETENTION_DAYS=90

# Security - HIPAA Compliance
HIPAA_COMPLIANT=True
ENCRYPT_PHI=True
ENCRYPTION_KEY=your-encryption-key
AUDIT_LOGGING_ENABLED=True
SESSION_TIMEOUT_MINUTES=15

# Third-Party APIs (Optional)
OPENAI_API_KEY=
SENDGRID_API_KEY=

# Feature Flags
FEATURE_WEB_UI=True
FEATURE_API=True
FEATURE_DESKTOP_GUI=True
FEATURE_AUTOMATION=False
FEATURE_ANALYTICS=True

# Development Settings
DEBUG_MODE=False
VERBOSE_LOGGING=False
TEST_MODE=False

# Server Configuration
WORKERS=4
WORKER_CLASS=sync
WORKER_CONNECTIONS=1000
KEEPALIVE=5

# Cache Configuration
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_DEFAULT_TIMEOUT=300

# Session Configuration
SESSION_TYPE=redis
SESSION_REDIS_URL=redis://localhost:6379/2
SESSION_PERMANENT=False
PERMANENT_SESSION_LIFETIME=3600
